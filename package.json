{
	"name": "md-annotation",
	"version": "1.0.28",
	"description": "Delimiter-free annotations and comments for Obsidian: highlights anchored by text-quote selectors, stored in an end-of-file block.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"esbuild": "0.28.2",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"prettier": "^3.10.1",
		"tslib": "2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@codemirror/state": "6.6.0",
		"@codemirror/view": "6.43.1",
		"obsidian": "1.8.7"
	}
}
